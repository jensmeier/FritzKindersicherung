{
  "elements": [
    {
      "type": "ExpansionPanel",
      "caption": "FRITZ!Box Verbindung",
      "expanded": true,
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "Host",
          "caption": "FRITZ!Box Host/IP"
        },
        {
          "type": "ValidationTextBox",
          "name": "User",
          "caption": "FRITZ!Box Benutzer"
        },
        {
          "type": "PasswordTextBox",
          "name": "Password",
          "caption": "FRITZ!Box Kennwort"
        },
        {
          "type": "CheckBox",
          "name": "PreferHTTPS",
          "caption": "TR-064 bevorzugt per HTTPS (Port 49443)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "PIN-Schutz der Kachel",
      "expanded": true,
      "items": [
        {
          "type": "PasswordTextBox",
          "name": "TilePin",
          "caption": "PIN (4 bis 8 Ziffern)"
        },
        {
          "type": "NumberSpinner",
          "name": "UnlockSeconds",
          "caption": "Automatisch wieder sperren nach",
          "suffix": " Sekunden",
          "minimum": 30,
          "maximum": 1800
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Elternansicht auf Tablet / Fully Kiosk",
      "expanded": true,
      "items": [
        {
          "type": "CheckBox",
          "name": "AutoOpenParentVisualization",
          "caption": "Nach korrekter PIN automatisch große Eltern-Visualisierung öffnen"
        },
        {
          "type": "SelectInstance",
          "name": "ParentVisualizationID",
          "caption": "Kachel-Visualisierung für Elternansicht"
        },
        {
          "type": "Label",
          "caption": "BUILD14: Die Ziel-Visualisierung kann unten per Automatik-Assistent erzeugt und eingetragen werden. Der Wechsel erfolgt per Browser-URL und ist für Fully Kiosk sowie normale Browser gedacht."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Sicherheit und Aktualisierung",
      "expanded": true,
      "items": [
        {
          "type": "CheckBox",
          "name": "ReadOnly",
          "caption": "Testmodus: nur lesen, keine FRITZ!Box ändern"
        },
        {
          "type": "NumberSpinner",
          "name": "RefreshSeconds",
          "caption": "Status aktualisieren alle",
          "suffix": " Sekunden",
          "minimum": 15,
          "maximum": 3600
        }
      ]
    },
    {
      "type": "Label",
      "caption": "Geräte automatisch suchen: Neue Geräte werden absichtlich NICHT aktiviert. Gewünschte Geräte anhaken, Person/Gruppe (z. B. Paul oder Tom) eintragen und danach Übernehmen drücken."
    },
    {
      "type": "List",
      "name": "Devices",
      "caption": "Geräte aus der FRITZ!Box",
      "rowCount": 12,
      "add": true,
      "delete": true,
      "columns": [
        {
          "caption": "Aktiv",
          "name": "Enabled",
          "width": "60px",
          "add": false,
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "caption": "Person/Gruppe",
          "name": "Group",
          "width": "120px",
          "add": "",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "Gerätename",
          "name": "Name",
          "width": "220px",
          "add": "",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "IPv4-Adresse",
          "name": "IP",
          "width": "130px",
          "add": "",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "MAC-Adresse",
          "name": "MAC",
          "width": "145px",
          "add": "",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "Status",
          "name": "Status",
          "width": "90px",
          "add": "manuell"
        },
        {
          "caption": "Verbindung",
          "name": "Interface",
          "width": "95px",
          "add": ""
        },
        {
          "caption": "FRITZ!-Profil",
          "name": "Profile",
          "width": "160px",
          "add": ""
        }
      ],
      "values": []
    }
  ],
  "actions": [
    {
      "type": "Label",
      "caption": "BUILD14: Automatik-Assistent für eine separate große Eltern-Visualisierung. Funktioniert browserbasiert auf Fully Kiosk, Android-Browsern und Windows-Browsern."
    },
    {
      "type": "Button",
      "caption": "Eltern-Visualisierung automatisch einrichten",
      "onClick": "echo FKS_SetupParentVisualization($id);"
    },
    {
      "type": "Button",
      "caption": "Geräte automatisch suchen / importieren",
      "onClick": "echo FKS_DiscoverDevices($id);"
    },
    {
      "type": "Button",
      "caption": "Verbindung / TR-064 testen",
      "onClick": "echo FKS_TestConnection($id);"
    },
    {
      "type": "Button",
      "caption": "Gerätestatus jetzt lesen",
      "onClick": "FKS_Refresh($id); echo 'Aktualisierung ausgelöst';"
    }
  ]
}